generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ----------------------------------------------------
// MILESTONE 1: ORGANIZATIONAL STRUCTURE
// ----------------------------------------------------

model Department {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "Chemical Engineering"
  code      String   @unique // e.g. "CHEM"
  
  courses   Course[]
}

model Course {
  id           String     @id @default(cuid())
  code         String     @unique // e.g. "CHE 101"
  title        String     // e.g. "Introduction to Mass Balances"
  year         Int        // 1, 2, 3, 4
  semester     Int        // 1, 2
  
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  
  topics       Topic[]
  questions    Question[]
}

model Topic {
  id           String     @id @default(cuid())
  title        String     // e.g. "Thermodynamics 1st Law"
  
  courseId     String
  course       Course     @relation(fields: [courseId], references: [id])
  
  questions    Question[]
}

// ----------------------------------------------------
// MILESTONE 1: QUESTION ENGINE CORE
// ----------------------------------------------------

model Question {
  id             String    @id @default(cuid())
  
  // The actual question text
  prompt         String    
  
  // E.g., MULTIPLE_CHOICE, CALCULATION, THEORY
  type           String    
  
  // The standard written solution or correct answer revealed during review
  standardSolution String?   
  
  // 1 (Easy) to 5 (Hard)
  difficulty     Int       
  
  // Optional flag to track style. E.g. "Dr. Osei"
  lecturerTag    String?   
  
  // E.g., "TUTORIAL", "EXAM_2022", "EXAM_2023"
  source         String?   
  
  // AI-generated reasoning for the review section
  aiExplanation  String?   

  // Links to Course & Topic
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id])
  topicId        String
  topic          Topic     @relation(fields: [topicId], references: [id])

  options        Option[]
  
  createdAt      DateTime  @default(now())
}

model Option {
  id         String   @id @default(cuid())
  text       String
  isCorrect  Boolean  @default(false)
  
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}
